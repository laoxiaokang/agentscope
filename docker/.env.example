# Required: Zilliz Cloud/Milvus token used by examples/agent_service/main.py.
MILVUS_TOKEN=change-me

# Optional service settings.
MILVUS_URI=https://in03-27c7c2ecead182f.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_DB_NAME=default

# Required: pre-created AWS S3 or S3-compatible bucket.
S3_BUCKET=change-me
S3_ENDPOINT=
S3_USE_SSL=true
S3_ADDRESSING_STYLE=auto
S3_SIGNATURE_VERSION=s3v4
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Required: existing Redis instance reachable from inside Docker.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
AGENT_SERVICE_PORT=8000
WEB_UI_PORT=8080

# Optional MCP integrations. Leave blank to disable them.
AMAP_API_KEY=
LUCKIN_MCP_TOKEN=

# Browser MCP is preinstalled in the agent-service image.
PLAYWRIGHT_MCP_COMMAND=playwright-mcp
PLAYWRIGHT_MCP_ARGS=--headless --no-sandbox --executable-path /opt/playwright-browser/chrome
